# JUEGOS — rules for /juegos (plain HTML, CSS and JS). The only server code is the
# TURBO PISTA ranking in pista/api/, which has its own .htaccess.

DirectoryIndex index.html
Options -Indexes -MultiViews
AddDefaultCharset UTF-8

# Dotfiles and docs are not part of the site.
<FilesMatch "(^\.|\.(md|yml|yaml|sh|bak|log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Behind Cloudflare Flexible the origin speaks plain HTTP, so Apache's own
# "add the trailing slash" redirect would point to http://. Do it here with https.
# /juegos itself (no slash) is outside this file's rewrite context: redirect it here.
<If "%{REQUEST_URI} == '/juegos'">
    Redirect 301 https://samueltorres.dev/juegos/
</If>
<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectorySlash Off
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # HTML, CSS and JS keep their names between versions: always revalidate.
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(woff2|webp|png|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType text/javascript .js
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>
